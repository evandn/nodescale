{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodescale",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The SPA. Every request goes through the Worker first so security headers
  // apply to static files too.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "vars": {
    // Set these to your deployment's hostname. Passkeys are bound to RP_ID,
    // and every agent is configured to accept only this origin.
    "RP_ID": "localhost",
    "ORIGIN": "http://localhost:8787",
    "SIGNUP": "invite"
  },
  // Secrets (wrangler secret put): RELAY_SECRET — 32+ random characters.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodescale",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "containers": [
    {
      "class_name": "Relay",
      "image": "../../relay/Dockerfile",
      "max_instances": 20
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
